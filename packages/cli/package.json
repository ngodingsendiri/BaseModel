{
  "name": "@basemodel/cli",
  "version": "0.1.0",
  "description": "Command-line interface for querying BaseModel AI intelligence",
  "type": "module",
  "bin": {
    "basemodel": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/basemodel/basemodel"
  },
  "license": "MIT",
  "keywords": [
    "ai",
    "models",
    "cli",
    "search",
    "basemodel"
  ],
  "scripts": {
    "build": "tsup src/cli.ts --format esm --clean",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@basemodel/intelligence": "workspace:*",
    "@basemodel/registry": "workspace:*",
    "@basemodel/schema": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0",
    "rimraf": "^6.0.0"
  }
}
