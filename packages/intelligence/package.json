{
  "name": "@basemodel/intelligence",
  "version": "0.1.0",
  "description": "Intelligence layer - rankings, recommendations, and derived insights from AI model registry data",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ngodingsendiri/BaseModel.git"
  },
  "license": "MIT",
  "keywords": [
    "ai",
    "models",
    "intelligence",
    "search",
    "recommendations",
    "basemodel"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@basemodel/schema": "workspace:*",
    "@basemodel/registry": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0",
    "rimraf": "^6.0.0"
  }
}

