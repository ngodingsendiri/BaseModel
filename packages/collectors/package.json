{
  "name": "@basemodel/collectors",
  "version": "0.1.0",
  "private": true,
  "description": "Discovery layer — provider-specific data collectors for the AI ecosystem",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@basemodel/schema": "workspace:*",
    "@basemodel/registry": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0",
    "rimraf": "^6.0.0"
  }
}
